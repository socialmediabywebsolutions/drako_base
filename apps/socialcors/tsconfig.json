{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "tsBuildInfoFile": ".next/cache/tsconfig.tsbuildinfo",
    "paths": {
      "@/app/*": ["./src/app/*"],
      "@/*": ["../../src/*"],
      "@shared-neutral/*": ["../../packages/shared-neutral/src/*"],
      "@shared-cloudflare/*": ["../../packages/shared-cloudflare/src/*"],
      "@shared-ui-neutral/*": ["../../packages/shared-ui-neutral/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    "../../src/types/**/*.d.ts"
  ],
  "exclude": ["node_modules", ".open-next", "worker.ts", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
