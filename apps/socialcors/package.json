{
  "name": "@drako/socialcors",
  "version": "0.1.0",
  "private": true,
  "description": "App Next.js/OpenNext propia de SocialCors (P3). Etapa alias: usa node_modules y src/ de la raíz del monorepo.",
  "scripts": {
    "dev": "../../node_modules/.bin/next dev",
    "build": "next build && mkdir -p .next/standalone/.next/server && echo \"{}\" > .next/standalone/.next/server/pages-manifest.json && echo \"{}\" > .next/standalone/.next/server/app-path-routes-manifest.json",
    "build:cf": "opennextjs-cloudflare build",
    "typecheck": "../../node_modules/.bin/tsc -p tsconfig.typecheck.json --noEmit",
    "deploy:dry-run": "../../node_modules/.bin/wrangler deploy --config wrangler.toml --dry-run --outdir .wrangler/dry-run",
    "build:opennext": "opennextjs-cloudflare build"
  },
  "devDependencies": {
    "wrangler": "^4.149.0"
  }
}
