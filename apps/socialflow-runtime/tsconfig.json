{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "../../src/*"
      ],
      "@runtime/*": [
        "./src/*"
      ],
      "@shared-neutral/*": [
        "../../packages/shared-neutral/src/*"
      ],
      "@shared-cloudflare/*": [
        "../../packages/shared-cloudflare/src/*"
      ],
      "@shared-ui-neutral/*": [
        "../../packages/shared-ui-neutral/src/*"
      ]
    }
  },
  "include": [
    "next.config.ts",
    "open-next.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    ".next",
    ".open-next",
    "node_modules"
  ]
}
