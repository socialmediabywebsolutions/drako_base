{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "scripts/.dist",
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2020",
    "esModuleInterop": true,
    "noEmit": false,
    "baseUrl": ".",
    "paths": {
      "@cloudflare/next-on-pages": ["scripts/shims/next-on-pages"],
      "@/*": ["src/*"]
    }
  },
  "include": [
    "scripts/**/*.ts",
    "workers/autopilot-worker/src/**/*.ts",
    "src/app/api/companies/route.ts",
    "src/app/api/company-domains/route.ts",
    "src/app/api/companies/[id]/domains/route.ts",
    "src/app/api/inbox/route.ts",
    "src/app/api/projects/route.ts",
    "src/app/api/projects/[id]/route.ts",
    "src/app/api/projects/[id]/domains/route.ts",
    "src/app/api/projects/[id]/domains/verify/route.ts"
  ]
}
