{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@cloudflare/next-on-pages": ["scripts/shims/next-on-pages"],
      "@/*": ["src/*"],
      "@shared-neutral/*": ["packages/shared-neutral/src/*"],
      "@shared-cloudflare/*": ["packages/shared-cloudflare/src/*"],
      "@shared-ui-neutral/*": ["packages/shared-ui-neutral/src/*"]
    }
  },
  "include": [
    "scripts/**/*.ts",
    "workers/autopilot-worker/src/**/*.ts",
    "src/app/api/companies/route.ts",
    "src/app/api/company-domains/route.ts",
    "src/app/api/companies/[id]/domains/route.ts",
    "src/app/api/inbox/route.ts",
    "src/app/api/projects/route.ts",
    "src/app/api/projects/[id]/route.ts",
    "src/app/api/projects/[id]/domains/route.ts",
    "src/app/api/projects/[id]/domains/verify/route.ts",
    "src/app/api/projects/[id]/entitlements/route.ts",
    "src/app/api/projects/[id]/entitlements/context/route.ts"
  ]
}
