{
  "name": "drako.systems",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "qa": "npm run lint && npm run build",
    "devarchitect:audit": "tsc --project tsconfig.scripts.json && node scripts/.dist/devarchitect-audit.js",
    "cf:build": "cross-env NEXT_ON_PAGES_PACKAGE_MANAGER=npm next-on-pages",
    "cf:preview": "cross-env NEXT_ON_PAGES_PACKAGE_MANAGER=npm wrangler pages dev .vercel/output/static --d1=DRACO_DB",
    "cf:deploy": "wrangler pages deploy .vercel/output/static",
    "test:mapping": "node scripts/check-mapping.js"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "15.4.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "stripe": "^20.1.0"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@cloudflare/workers-types": "^4.20250204.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^20.17.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "15.5.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.48.0"
  }
}
