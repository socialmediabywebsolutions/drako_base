{
  "name": "drako.systems",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "cf:build": "npx opennextjs-cloudflare build --config wrangler.workers.toml --env production && node scripts/finalize-worker.js && node -e \"if(!require('fs').existsSync('.open-next/worker.js')) { console.error('❌ FATAL: .open-next/worker.js not found'); process.exit(1) }\"",
    "cf:deploy": "npx wrangler deploy --config wrangler.workers.toml --env production",
    "cf:preview": "npm run cf:build && npx wrangler dev --config wrangler.workers.toml",
    "build:worker": "npm run cf:build",
    "deploy": "npm run cf:deploy",
    "start": "next start",
    "lint": "eslint src",
    "qa": "npm run lint && npm run build",
    "hostnames:tests": "tsc --project tsconfig.scripts.json && node scripts/.dist/scripts/hostnames-tests.js",
    "production:go": "tsc --project tsconfig.scripts.json && node scripts/.dist/scripts/production-go.js",
    "devarchitect:audit": "tsc --project tsconfig.scripts.json && node scripts/.dist/devarchitect-audit.js",
    "test:companies": "tsc --project tsconfig.scripts.json && node scripts/.dist/scripts/companies-api-tests.js",
    "test:company-domains": "tsc --project tsconfig.scripts.json && node scripts/.dist/scripts/company-domains-api-tests.js",
    "test:projects": "tsc --project tsconfig.scripts.json && node scripts/.dist/scripts/projects-api-tests.js",
    "test:project-domains": "tsc --project tsconfig.scripts.json && node scripts/.dist/scripts/project-domains-api-tests.js",
    "test:project-entitlements": "tsc --project tsconfig.scripts.json && node scripts/.dist/scripts/project-entitlements-api-tests.js",
    "test:project-entitlements-context": "tsc --project tsconfig.scripts.json && node scripts/.dist/scripts/project-entitlements-context-api-tests.js",
    "test:orchestrator-company": "tsc --project tsconfig.scripts.json && node scripts/.dist/scripts/orchestrator-company-tests.js",
    "test:orchestrator": "npm run test:company-domains && npm run test:companies && npm run test:orchestrator-company",
    "test:agents-catalog": "tsc --project tsconfig.scripts.json && node scripts/.dist/scripts/agents-catalog-tests.js",
    "test:projects-factory": "npm run test:projects && npm run test:project-domains && npm run test:project-entitlements && npm run test:project-entitlements-context && npm run test:agents-catalog",
    "test:mapping": "node scripts/check-mapping.js",
    "smoke:cloudflare": "node scripts/smokes-cloudflare.js",
    "check:alerts": "tsx scripts/alerts-check.ts",
    "seed:canon": "npx wrangler d1 execute drako_db_prod --local --file=scripts/create_canon_tables.sql && npx wrangler d1 execute drako_db_prod --local --file=scripts/seed_canon.sql",
    "verify:monetization": "tsx scripts/verify-holding-monetization.ts",
    "verify:provisioning": "tsx scripts/verify-provisioning-states.ts",
    "deploy:scheduler": "cd workers/drako-scheduler && npx wrangler deploy",
    "deploy:preflight": "node scripts/preflight-deploy.js",
    "deploy:production": "npm run cf:deploy",
    "deploy:all": "npm run deploy:scheduler && npm run deploy:preflight && npm run deploy:production"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.3.2",
    "clsx": "^2.1.1",
    "framer-motion": "^12.27.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "next": "15.5.9",
    "next-auth": "^4.24.13",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "stripe": "^20.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250204.0",
    "@opennextjs/cloudflare": "^1.16.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.17.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitest/coverage-v8": "^4.0.18",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "15.5.2",
    "jsdom": "^28.0.0",
    "open-next": "^3.1.3",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.0.18",
    "wrangler": "^4.65.0"
  }
}