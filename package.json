{
  "name": "drako.systems",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "qa": "npm run lint && npm run build",
    "devarchitect:audit": "tsc --project tsconfig.scripts.json && node scripts/.dist/devarchitect-audit.js",
    "build:cloudflare": "npx @opennextjs/cloudflare build",
    "pages:build": "node scripts/pages-build.js",
    "preview:cloudflare": "npm run build:cloudflare && npx wrangler dev --config wrangler.toml",
    "deploy:cloudflare": "npm run build:cloudflare && npx wrangler deploy --config wrangler.toml",
    "test:mapping": "node scripts/check-mapping.js",
    "smoke:cloudflare": "node scripts/smokes-cloudflare.js"
  },
  "dependencies": {
    "@cloudflare/next-on-pages": "1.13.16",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "15.5.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "stripe": "^20.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250204.0",
    "@opennextjs/cloudflare": "^1.14.7",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^20.17.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "15.5.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.48.0"
  }
}
