{
  "name": "drako.systems",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "qa": "npm run lint && npm run build",
    "hostnames:tests": "tsc --project tsconfig.scripts.json && node scripts/.dist/scripts/hostnames-tests.js",
    "production:go": "tsc --project tsconfig.scripts.json && node scripts/.dist/scripts/production-go.js",
    "devarchitect:audit": "tsc --project tsconfig.scripts.json && node scripts/.dist/devarchitect-audit.js",
    "pages:build": "npx @cloudflare/next-on-pages@1",
    "test:companies": "tsc --project tsconfig.scripts.json && node scripts/.dist/scripts/companies-api-tests.js",
    "test:company-domains": "tsc --project tsconfig.scripts.json && node scripts/.dist/scripts/company-domains-api-tests.js",
    "test:orchestrator-company": "tsc --project tsconfig.scripts.json && node scripts/.dist/scripts/orchestrator-company-tests.js",
    "test:orchestrator": "npm run test:company-domains && npm run test:companies && npm run test:orchestrator-company",
    "test:mapping": "node scripts/check-mapping.js",
    "smoke:cloudflare": "node scripts/smokes-cloudflare.js"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "15.5.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "stripe": "^20.1.0"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "1.13.16",
    "@cloudflare/workers-types": "^4.20250204.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^20.17.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "15.5.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.48.0"
  }
}
