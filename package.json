{
  "name": "drako.systems",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "dev:wrangler": "npm run build:factory && wrangler dev --local",
    "build": "next build",
    "mentoria:local:bootstrap": "node scripts/local/mentoria-local-bootstrap.mjs",
    "mentoria:local:bootstrap:align-worker": "node scripts/local/mentoria-local-bootstrap.mjs --align-worker",
    "mentoria:local:smoke": "node scripts/local/mentoria-local-smoke.mjs",
    "mentoria:local:qa": "node scripts/local/mentoria-local-qa.mjs",
    "mentoria:local:qa:align-worker": "node scripts/local/mentoria-local-qa.mjs --align-worker",
    "test": "vitest run",
    "audit:control-plane-separation": "tsx scripts/audit-control-plane-separation.ts --write",
    "check:no-pages": "tsx scripts/check-no-pages.ts",
    "check:no-placeholder-secrets": "node scripts/check-no-placeholder-secrets.mjs",
    "build:artifacts:skeleton": "node scripts/build-artifact-matrix-skeleton.mjs",
    "socialflow-runtime:build": "node scripts/build-socialflow-runtime.mjs",
    "precf:build": "npm run check:no-pages && npm run check:no-placeholder-secrets",
    "postbuild:factory": "node scripts/patch-opennext-mentoria-runtime.mjs && ARTIFACT_MATRIX_PRODUCT=all ARTIFACT_MATRIX_REQUIRE_GLOBAL_BUILD=1 node scripts/build-artifact-matrix-skeleton.mjs && node scripts/patch-socialflow-cron-handler.mjs",
    "build:factory": "npm run check:no-pages && npm run check:no-placeholder-secrets && npx opennextjs-cloudflare build && npm run postbuild:factory",
    "archived:cf:build": "node -e \"console.error('ARCHIVED_WORKER_BLOCKED: drako-base-3 is decommissioned. Use pnpm build:factory or .github/workflows/drako-factory-deploy.yml.'); process.exit(1)\"",
    "cf:build": "npm run build:factory",
    "precf:deploy": "npm run check:no-pages && npm run check:no-placeholder-secrets",
    "archived:cf:deploy": "node -e \"console.error('ARCHIVED_WORKER_BLOCKED: root production deploy is no longer valid. Use .github/workflows/drako-factory-deploy.yml.'); process.exit(1)\"",
    "cf:deploy": "npm run archived:cf:deploy",
    "archived:cf:preview": "node -e \"console.error('ARCHIVED_WORKER_BLOCKED: drako-base-3 preview is decommissioned. Use .github/workflows/drako-factory-deploy.yml for canonical deploys.'); process.exit(1)\"",
    "cf:preview": "npm run archived:cf:preview",
    "build:worker": "npm run build:factory",
    "deploy": "npm run archived:cf:deploy",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit && tsc -p apps/socialcors/tsconfig.json --noEmit",
    "qa": "npm run lint && npm run build",
    "hostnames:tests": "tsc --project tsconfig.scripts.json && node scripts/.dist/scripts/hostnames-tests.js",
    "production:go": "tsc --project tsconfig.scripts.json && node scripts/.dist/scripts/production-go.js",
    "devarchitect:audit": "tsc --project tsconfig.scripts.json && node scripts/.dist/devarchitect-audit.js",
    "test:companies": "tsc --project tsconfig.scripts.json && node scripts/.dist/scripts/companies-api-tests.js",
    "test:company-domains": "tsc --project tsconfig.scripts.json && node scripts/.dist/scripts/company-domains-api-tests.js",
    "test:projects": "tsc --project tsconfig.scripts.json && node scripts/.dist/scripts/projects-api-tests.js",
    "test:project-domains": "tsc --project tsconfig.scripts.json && node scripts/.dist/scripts/project-domains-api-tests.js",
    "test:project-entitlements": "tsc --project tsconfig.scripts.json && node scripts/.dist/scripts/project-entitlements-api-tests.js",
    "test:project-entitlements-context": "tsc --project tsconfig.scripts.json && node scripts/.dist/scripts/project-entitlements-context-api-tests.js",
    "test:orchestrator-company": "tsc --project tsconfig.scripts.json && node scripts/.dist/scripts/orchestrator-company-tests.js",
    "test:orchestrator": "npm run test:company-domains && npm run test:companies && npm run test:orchestrator-company",
    "test:agents-catalog": "tsc --project tsconfig.scripts.json && node scripts/.dist/scripts/agents-catalog-tests.js",
    "test:projects-factory": "npm run test:projects && npm run test:project-domains && npm run test:project-entitlements && npm run test:project-entitlements-context && npm run test:agents-catalog",
    "test:mapping": "node scripts/check-mapping.js",
    "smoke:cloudflare": "node scripts/smokes-cloudflare.js",
    "smoke:socialflow:canonical:manual": "node scripts/smoke/socialflow-canonical-domain-smoke.mjs",
    "check:workers": "cross-env TMPDIR=/tmp tsx scripts/check-workers-drift.ts",
    "check:workers:fixtures": "cross-env TMPDIR=/tmp FIXTURES_DIR=tests/fixtures/workers-drifts/pass tsx scripts/check-workers-drift.ts",
    "check:hostnames": "cross-env TMPDIR=/tmp tsx scripts/check-hostnames-drift.ts",
    "check:hostnames:fixtures": "cross-env TMPDIR=/tmp FIXTURES_DIR=tests/fixtures/hostnames-drifts/pass tsx scripts/check-hostnames-drift.ts",
    "check:production": "cross-env TMPDIR=/tmp tsx scripts/check-production-readiness.ts",
    "check:production:fixtures": "cross-env TMPDIR=/tmp FIXTURES_DIR=tests/fixtures/production-audits/pass tsx scripts/check-production-readiness.ts",
    "check:production:with-artifacts": "pnpm build:artifacts:skeleton && pnpm check:production:fixtures",
    "backfill:provisioning": "cross-env TMPDIR=/tmp tsx scripts/backfill-provisioning-success.ts",
    "bootstrap:observability": "cross-env TMPDIR=/tmp tsx scripts/bootstrap-observability-fallback.ts",
    "replay:observability": "cross-env TMPDIR=/tmp tsx scripts/replay-observability-fallbacks.ts",
    "predeploy:holding": "npm run check:workers && npm run check:hostnames && npm run check:production",
    "test:workers": "vitest run tests/workers-drift.test.ts",
    "test:hostnames": "vitest run tests/hostnames-drift.test.ts",
    "test:production": "vitest run tests/production-readiness.test.ts",
    "check:alerts": "tsx scripts/alerts-check.ts",
    "seed:canon": "npx wrangler d1 execute drako_db_prod --local --file=scripts/create_canon_tables.sql && npx wrangler d1 execute drako_db_prod --local --file=scripts/seed_canon.sql",
    "verify:monetization": "tsx scripts/verify-holding-monetization.ts",
    "verify:auth-ssot": "tsx scripts/verify-auth-ssot.ts",
    "verify-auth-ssot": "tsx scripts/verify-auth-ssot.ts",
    "test:auth-isolation": "tsx scripts/test-auth-isolation.ts",
    "verify:provisioning": "tsx scripts/verify-provisioning-states.ts",
    "deploy:scheduler": "node -e \"console.error('CANONICAL_DEPLOY_ONLY: deploy via .github/workflows/drako-factory-deploy.yml. Root partial worker deploy scripts are disabled.'); process.exit(1)\"",
    "deploy:saas-factory": "node -e \"console.error('CANONICAL_DEPLOY_ONLY: deploy via .github/workflows/drako-factory-deploy.yml. Root partial worker deploy scripts are disabled.'); process.exit(1)\"",
    "deploy:preflight": "node -e \"console.error('CANONICAL_DEPLOY_ONLY: preflight now runs inside .github/workflows/drako-factory-deploy.yml.'); process.exit(1)\"",
    "deploy:production": "npm run archived:cf:deploy",
    "deploy:all": "npm run archived:cf:deploy"
  },
  "dependencies": {
    "@cf-wasm/photon": "^0.4.0",
    "@react-pdf/renderer": "^4.3.2",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "exifr": "^7.1.3",
    "framer-motion": "^12.27.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "mp4-muxer": "^5.2.2",
    "next": "15.5.9",
    "next-auth": "^4.24.13",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^3.10.1",
    "stripe": "^20.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250204.0",
    "@eslint/eslintrc": "^3.3.5",
    "@opennextjs/cloudflare": "^1.16.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.17.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitest/coverage-v8": "^4.0.18",
    "better-sqlite3": "^12.8.0",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "15.5.2",
    "jsdom": "^28.0.0",
    "open-next": "^3.1.3",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.0.18",
    "wrangler": "^4.65.0"
  }
}
