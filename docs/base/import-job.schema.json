{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drako.systems/schemas/import-job.schema.json",
  "title": "Import Job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tenant_id",
    "source",
    "type",
    "status",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "saas_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "string",
      "description": "gmail, drive, upload, url"
    },
    "type": {
      "type": "string",
      "description": "pdf_catalog, invoice, lead_list"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed"
      ]
    },
    "input": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "output": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
