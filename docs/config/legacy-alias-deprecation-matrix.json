        "legacy usage measured on /api/owner/** and /api/campobase/**",
        "sensitive telemetry redaction validated",
        "operator/factory callers migrated"
      ]
    },
    {
      "phase": "P0.7",
      "goal": "Read telemetry + evaluate cut readiness without removing routes",
      "exitCriteria": [
        "usage report available in summary/json/markdown",
        "ready-for-cut criteria defined",
        "not-ready-for-cut criteria defined",
        "readyForCut false by default",
        "requiresHumanApproval true"
      ]
    },
    {
      "phase": "P0.8",
      "goal": "Build sunset decision pack without cutting routes",
      "exitCriteria": [
        "decision pack generated",
        "alias classes assigned",
        "rollback checklist defined",
        "approval checklist defined",
        "readyForCut false by default"
      ]
    },
    {
      "phase": "P0.9",
      "goal": "Selective cut with explicit approvals",
      "exitCriteria": [
        "legacy traffic data reviewed",
        "migrated callers validated",
        "rollback drill validated",
        "manual approval",
        "rollback plan ready"
      ]
    }
