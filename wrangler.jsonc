{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "drakosystems",
	"compatibility_date": "2026-03-17",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public",
		"experimental"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"ai": {
		"binding": "AI"
	},
	"vars": {
		"SOCIALFLOW_STRIPE_PRICE_PRO": "price_1TiSu1BflYSFyTbP1gQOsicz",
		"SOCIALFLOW_STRIPE_PRICE_CREATOR": "price_1TiSvUBflYSFyTbP0SnF7VAj"
	},
	"d1_databases": [
		{
			"binding": "DRACO_DB",
			"database_name": "drako_db_prod",
			"database_id": "5607a76a-97c7-45a9-a948-e545ba27eae7"
		},
		{
			"binding": "MENTORIAS_AUTHS_DB",
			"database_name": "mentorias_auths_prod_db",
			"database_id": "6a6e3b5c-4d5e-4905-850a-b1e205203462"
		},
		{
			"binding": "MENTORIA_DB",
			"database_name": "saas_mentorias_prod_db",
			"database_id": "67b013a3-dcd8-424b-adf9-558895817841"
		},
		{
			"binding": "DRAKOS_AUTHS_DB",
			"database_name": "drako_db_prod",
			"database_id": "5607a76a-97c7-45a9-a948-e545ba27eae7"
		},
		{
			"binding": "BASES_AUTHS_DB",
			"database_name": "drako_db_prod",
			"database_id": "5607a76a-97c7-45a9-a948-e545ba27eae7"
		},
		{
			"binding": "SOCIAL_DB",
			"database_name": "saas_socialflows_prod_db",
			"database_id": "6aa6dbaf-9e35-4715-b154-cda8aee0bd54"
		},
		{
			"binding": "SOCIALFLOW_AUTHS_DB",
			"database_name": "saas_socialflow_auths_prod_db",
			"database_id": "f6f46e6a-487f-400a-a2d1-c6d23e88f9cf"
		}
	],
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "drakosystems"
		}
	],
	"r2_buckets": [
		{
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			"bucket_name": "drakosystems-opennext-cache"
		},
		{
			"binding": "SOCIAL_MEDIA_BUCKET",
			"bucket_name": "socialflow-media"
		},
		{
			"bucket_name": "socialflow-media",
			"binding": "socialflow_media",
			"remote": true
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"triggers": {
		"crons": [
			{ "cron": "0 8 * * *" }
		]
	}
}
